# Copy to .env and load it however you prefer; iofi reads plain environment vars.

IOFI_ADDR=:8080
IOFI_DATABASE_URL=postgres://iofi:iofi@localhost:5432/iofi?sslmode=disable
IOFI_DATA_DIR=data

# Guards every /api route. The API hires agents, dispatches runs with filesystem
# access, and reads the whole shared memory — it is not a read-only dashboard.
# Left blank, iofi generates one at boot and prints it to the log.
IOFI_AUTH_TOKEN=
IOFI_RATE_LIMIT_PER_MIN=600

# The URL agents are told to reach for MCP. Must be reachable from the agent
# process — change it if iofi runs behind a proxy or in a container.
IOFI_PUBLIC_URL=http://localhost:8080

# Coordinator brain. Agents keep their own CLI auth unless llm_mode=proxy.
IOFI_LITELLM_URL=http://localhost:4000
IOFI_LITELLM_KEY=sk-iofi-local
IOFI_BRAIN_MODEL=gpt-4o-mini
IOFI_EMBED_MODEL=text-embedding-3-small
# Must match the vector(N) column in migration 0001. Changing the embedding
# model to one with different dimensions requires altering that column.
IOFI_EMBED_DIM=1536

# Blank disables GitHub sync and the pr_open tool; everything else still runs.
# A repository with no secret of its own rejects webhook deliveries outright.
IOFI_GITHUB_TOKEN=
IOFI_GITHUB_WEBHOOK_SECRET=

IOFI_MAX_RUNS=4
IOFI_EVENT_RETENTION_DAYS=30

# Used by docker-compose, not by iofi itself.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
LITELLM_MASTER_KEY=sk-iofi-local
